using "ui/basic.style";
using "ui/widgets/widgets.style";
using "intro/intro.style";

// Placeholder pages for the GB sections (Feed, Transfers).
gbPageMaxWidth: 480px;
gbPagePadding: margins(32px, 96px, 32px, 32px);
gbPageTitle: FlatLabel(introTitle) {
	align: align(top);
}
gbPageAboutSkip: 12px;
gbPageAbout: FlatLabel(introDescription) {
	align: align(top);
}

// Home: the downloader.
gbDlMaxWidth: 820px;
gbDlPadding: margins(16px, 12px, 16px, 0px);
gbDlFieldSkip: 8px;
gbDlTopSkip: 8px;
gbDlTabsSkip: 4px;
gbDlRowPadding: margins(16px, 8px, 16px, 8px);
gbDlThumbSize: 54px;
gbDlInnerSize: 40px;
gbDlNameLeft: 12px;
gbDlNameTop: 9px;
gbDlStatusTop: 29px;
gbDlInfoTop: 47px;
gbDlExtFont: font(13px semibold);
gbDlRadialLine: 3px;
gbDlEmptyTop: 72px;
gbDlEmpty: FlatLabel(introDescription) {
	align: align(top);
}
gbDlSummary: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
}
gbDlSummaryHeight: 22px;
gbDlBoxTitle: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	minWidth: 280px;
	maxHeight: 60px;
}
gbDlBoxAbout: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	minWidth: 280px;
}
