using "ui/basic.style";
using "ui/widgets/widgets.style";
using "intro/intro.style";

// Placeholder pages for the GB sections (Feed, Transfers).
gbPageMaxWidth: 480px;
gbPagePadding: margins(32px, 96px, 32px, 32px);
gbPageTitle: FlatLabel(introTitle) {
	align: align(top);
}
gbPageAboutSkip: 12px;
gbPageAbout: FlatLabel(introDescription) {
	align: align(top);
}

// Home: the downloader.
gbDlMaxWidth: 820px;
gbDlPadding: margins(16px, 12px, 16px, 0px);
gbDlFieldSkip: 8px;
gbDlTopSkip: 8px;
gbDlTabsSkip: 4px;
gbDlRowPadding: margins(16px, 8px, 16px, 8px);
gbDlThumbSize: 54px;
gbDlInnerSize: 40px;
gbDlNameLeft: 12px;
gbDlNameTop: 9px;
gbDlStatusTop: 29px;
gbDlInfoTop: 47px;
gbDlExtFont: font(13px semibold);
gbDlRadialLine: 3px;
gbDlEmptyTop: 72px;
gbDlEmpty: FlatLabel(introDescription) {
	align: align(top);
}
gbDlSummary: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
}
gbDlSummaryHeight: 22px;
gbDlBoxTitle: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	minWidth: 280px;
	maxHeight: 60px;
}
gbDlBoxAbout: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	minWidth: 280px;
}

// The browser's "New download" window (a separate window, like IDM's).
gbCaptureWidth: 540px;
gbCapturePadding: margins(24px, 6px, 24px, 14px);
gbCaptureSkip: 8px;
gbCaptureTitle: FlatLabel(defaultFlatLabel) {
	style: TextStyle(semiboldTextStyle) {
		font: font(15px semibold);
	}
	minWidth: 100px;
	maxHeight: 44px;
}
gbCaptureText: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
}
gbCaptureAbout: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	minWidth: 100px;
}
gbCaptureStatus: FlatLabel(defaultFlatLabel) {
	textFg: attentionButtonFg;
	minWidth: 60px;
	maxHeight: 40px;
}
gbCaptureBarHeight: 6px;
gbCaptureDropHeight: 52px;
gbCaptureButtonSkip: 4px;

// Feed.
gbFeedMaxWidth: 640px;
gbFeedPadding: margins(16px, 12px, 16px, 0px);
gbFeedCardPadding: margins(16px, 12px, 16px, 8px);
gbFeedHeaderHeight: 44px;
gbFeedUserpic: 40px;
gbFeedNameLeft: 52px;
gbFeedNameTop: 3px;
gbFeedSubTop: 23px;
gbFeedSkip: 8px;
gbFeedFileHeight: 56px;
gbFeedFileThumb: 48px;
gbFeedImageMaxHeight: 420px;
gbFeedBadgeFont: font(11px semibold);
gbFeedBadgePadding: margins(6px, 2px, 6px, 2px);
gbFeedText: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
}
gbFeedSub: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	minWidth: 100px;
}
gbFeedName: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	minWidth: 100px;
}
gbFeedTitle: FlatLabel(defaultFlatLabel) {
	style: TextStyle(semiboldTextStyle) {
		font: font(16px semibold);
	}
	minWidth: 100px;
}
gbFeedActionsHeight: 32px;
gbFeedActionSkip: 20px;
gbFeedSignInTop: 96px;
